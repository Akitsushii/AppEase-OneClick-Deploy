# AppEase server settings.
#
# Copy this file to server/.env and fill it in. server/.env is ignored by
# git and must never be committed: it holds the key that signs admin
# sessions and, if email is on, a mail password.
#
# Only SECRET_KEY is required. Everything else is optional and switches a
# feature on; left blank, that feature stays off.

# --- Required --------------------------------------------------------------

# Signs the admin session cookie. Anyone who knows it can sign in as any
# admin without a password, so it must be random, private and at least 32
# characters. Left blank on purpose: the server refuses to start until a
# real one is set. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Email (optional) ------------------------------------------------------
#
# With SMTP_HOST blank, no email is sent: new and reset passwords are shown
# on screen to the admin instead.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER is the
# address, and SMTP_PASSWORD is an app password (Google Account > Security >
# App passwords), not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 sends STARTTLS after connecting; 0 turns it off.
SMTP_USE_TLS=1
# Only used when SMTP_USER is a plain login name rather than an address.
# When SMTP_USER is an address, mail is always sent from SMTP_USER.
SMTP_FROM=

# --- Silent install flag detection (optional) ------------------------------
#
# A Silent Install HQ API key. When set, an uploaded .exe or .msi is sent
# there to suggest its silent-install flags. Blank: flags are typed by hand.
SILENTINSTALLHQ_API_KEY=

# --- QR stickers for the problem report form (optional) --------------------
#
# Signs the link on each computer's QR sticker and the code printed under
# it, which is how the report form knows the person is standing at that
# machine. Any long random string; generate it the same way as SECRET_KEY.
# Changing it invalidates every printed sticker. Blank: stickers and codes
# do not work, and the form opens only from a registered lab computer.
REPORT_QR_SECRET=

# --- Public report form over a tunnel (optional) ---------------------------
#
# The public hostname a Cloudflare Tunnel forwards to this server, without
# https:// or a path, for example report.example.test. On that hostname
# only the report form is served; every other page answers 404. QR stickers
# point at it. Blank: the app is LAN-only.
PUBLIC_REPORT_HOST=

# --- Demo mode (optional) --------------------------------------------------
#
# 1 lets /report?demo=1 open the real report form without a sticker, code
# or lab address, and discards whatever is submitted. Meant for showing the
# form to people outside the lab; leave it at 0 otherwise.
DEMO_MODE_ENABLED=0
